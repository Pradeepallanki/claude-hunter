# ---------- OS / editor ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

.idea/
.vscode/
*.iml

# ---------- Go core ----------
core/bin/

# ---------- VS Code extension ----------
vscode/node_modules/
vscode/out/
# Bundled Go binaries live under vscode/bin/<platform>-<arch>/. They are
# regenerated by the build; the packaged .vsix embeds them.
vscode/bin/

# ---------- IntelliJ plugin ----------
intellij/.gradle/
intellij/.intellijPlatform/
intellij/.kotlin/
intellij/bin/

# Keep only the built plugin .zip out of intellij/build/.
intellij/build/*
!intellij/build/distributions/
intellij/build/distributions/*
!intellij/build/distributions/*.zip

# Bundled Go binaries under intellij/src/main/resources/bin/<platform>-<arch>/.
intellij/src/main/resources/bin/
